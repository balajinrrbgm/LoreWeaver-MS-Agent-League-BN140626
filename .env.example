# =============================================================================
# LoreWeaver configuration
# Copy this file to ".env" and fill in values. NEVER commit your real .env.
# LoreWeaver runs fully OFFLINE without any of these — they unlock live
# Foundry IQ agentic retrieval and Azure OpenAI narration.
# =============================================================================

# --- Server ---
PORT=4317

# --- Foundry IQ (Azure AI Search agentic retrieval / knowledge base) ---
# Endpoint of your Azure AI Search service that backs the Foundry IQ knowledge base.
# Example: https://my-search.search.windows.net
FOUNDRY_IQ_SEARCH_ENDPOINT=
# Name of the knowledge base / agentic retrieval agent created in Foundry.
FOUNDRY_IQ_KNOWLEDGE_BASE=
# Admin or query API key for the search service (use a query key where possible).
FOUNDRY_IQ_API_KEY=
# REST API version that supports agentic retrieval.
FOUNDRY_IQ_API_VERSION=2025-08-01-preview

# --- Azure OpenAI (narration model used by the story engine) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
