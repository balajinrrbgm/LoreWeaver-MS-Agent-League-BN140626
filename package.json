{
  "name": "loreweaver",
  "version": "1.0.0",
  "description": "LoreWeaver — a grounded interactive storytelling studio that weaves branching, citation-backed fiction from your own world bible using Foundry IQ agentic retrieval.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/server/index.js",
    "mcp": "tsx src/mcp/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "github-copilot",
    "foundry-iq",
    "agentic-retrieval",
    "interactive-fiction",
    "mcp",
    "creative-ai",
    "azure"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
